# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/build-old*/

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarnrc.yml
.yarn
.eslintcache
pnpm-lock.yaml
.env
stats.html
*.tsbuildinfo

.idea
/test-results/
/blob-report/
/playwright/.cache/
playwright-report
# local release logs (dsh scripts)
/logs/
# local build error log
/build-error.log

# 核心回归产物（由 npm run test:core 生成）
/scripts/core-regression/core.mjs
/scripts/core-regression/report-*.json

# 桌面视觉回归：只忽略差异产物，基线 PNG 需要提交
/tests/desktop-visual/*.diff.png

# 本地工具链（rcedit / NSIS，按需下载，带校验，不进仓库）
/.tools/

# 发布产物与备份（npm run release / rollback 的默认目录）
/release/
/backup/
