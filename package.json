{
  "name": "qwerty-learner",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@floating-ui/react": "^0.20.1",
    "@headlessui/react": "^1.7.13",
    "@headlessui/tailwindcss": "^0.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-progress": "^1.0.2",
    "@radix-ui/react-radio-group": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-slider": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@vercel/analytics": "^1.5.0",
    "animate.css": "^4.1.1",
    "canvas-confetti": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.8",
    "dexie": "^3.2.3",
    "dexie-export-import": "^4.0.7",
    "echarts": "^5.6.0",
    "file-saver": "^2.0.5",
    "howler": "^2.2.3",
    "html-to-image": "^1.11.11",
    "immer": "^9.0.21",
    "jotai": "^2.0.3",
    "mixpanel-browser": "^2.45.0",
    "pako": "^2.1.0",
    "react": "^18.2.0",
    "react-activity-calendar": "^2.0.2",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^4.3.7",
    "react-router-dom": "^6.30.6",
    "react-tooltip": "^5.18.0",
    "swr": "^2.0.4",
    "tailwind-merge": "^2.1.0",
    "tailwindcss-animate": "^1.0.7",
    "use-immer": "^0.9.0",
    "use-sound": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "cross-env CI=false vite build --base=./",
    "test": "npm run typecheck && npm run lint:strict",
    "test:quality": "tsc --noEmit -p tsconfig.json && npm run typecheck:node && eslint src --ext .ts,.tsx --max-warnings 0",
    "test:format": "prettier --check .",
    "test:icons": "node scripts/icons.mjs --check",
    "icons": "node scripts/icons.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "cross-env QZ_E2E_BASE_URL=http://127.0.0.1:5173 playwright test --project=chromium",
    "test:local": "node scripts/dsh-smoke.mjs",
    "test:desktop-smoke": "node scripts/run-smoke.mjs",
    "test:start-level": "node scripts/verify-start-level.mjs",
    "test:pages": "node scripts/verify-pages.mjs",
    "test:csv": "node scripts/verify-csv-safe.mjs",
    "test:typing": "node scripts/verify-typing.mjs",
    "test:enhance": "node scripts/verify-enhance.mjs",
    "test:enhance:detail": "node scripts/verify-enhance-detail.mjs",
    "test:core": "node scripts/core-regression/run.mjs",
    "test:stats": "node scripts/verify-stats.mjs",
    "test:fuzz": "node scripts/verify-fuzz.mjs",
    "test:dict": "node scripts/verify-dict-fetch.mjs",
    "test:visual": "cross-env QZ_E2E_BASE_URL=http://127.0.0.1:5173 playwright test tests/e2e/visual.spec.ts --project=chromium --workers=1 --reporter=line",
    "test:desktop-visual": "node scripts/verify-desktop-visual.mjs",
    "test:desktop-visual:update": "node scripts/verify-desktop-visual.mjs --update",
    "test:desktop-visual:apply": "node scripts/apply-visual-baseline.mjs",
    "release": "node scripts/release.mjs",
    "release:test": "node scripts/release.mjs --test-install",
    "shell": "node scripts/shell.mjs",
    "package": "node scripts/package.mjs",
    "rollback": "node scripts/rollback.mjs",
    "rollback:list": "node scripts/rollback.mjs --list",
    "check:install": "node scripts/check-install.mjs",
    "test:all": "npm run test:icons && npm run test:quality && npm run test:stats && npm run test:word-stats && npm run test:fuzz && npm run test:dict && npm run test:core && npm run test:input-judge && npm run test:schema-sync && npm run test:review-persist && npm run test:start-level && npm run test:pages && npm run test:typing && npm run test:enhance && npm run test:enhance:detail && npm run test:csv",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:strict": "eslint src --ext .ts,.tsx --max-warnings 0",
    "quality": "npm run test:icons && npm run test:format && npm run test:quality && npm run test:stats && npm run test:word-stats && npm run test:fuzz && npm run test:dict && npm run test:core && npm run test:input-judge && npm run test:schema-sync && npm run test:review-persist",
    "prettier": "prettier --write .",
    "prepare": "husky install",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test:review-persist": "node scripts/verify-review-persist.mjs",
    "test:word-stats": "node scripts/verify-word-stats.mjs",
    "test:input-judge": "node scripts/verify-input-judge.mjs",
    "test:schema-sync": "node scripts/verify-schema-sync.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@iconify/json": "^2.2.242",
    "@playwright/test": "^1.40.1",
    "@svgr/core": "^6.5.1",
    "@svgr/plugin-jsx": "^6.5.1",
    "@tailwindcss/forms": "^0.5.3",
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "@types/canvas-confetti": "^1.6.0",
    "@types/file-saver": "^2.0.5",
    "@types/howler": "^2.2.3",
    "@types/mixpanel-browser": "^2.38.1",
    "@types/node": "18.14.6",
    "@types/pako": "^2.0.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.13",
    "cross-env": "^7.0.3",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "git-last-commit": "^1.0.1",
    "husky": "^8.0.0",
    "lint-staged": "^13.1.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "prettier": "^2.8.4",
    "prettier-plugin-tailwindcss": "^0.2.7",
    "rollup-plugin-visualizer": "^5.9.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.3.1",
    "typescript": "^4.0.3",
    "typescript-plugin-css-modules": "^5.0.1",
    "unplugin-icons": "^0.16.1",
    "vite": "^4.1.1"
  },
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.7"
}
